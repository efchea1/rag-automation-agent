# Copy this file to .env and fill in the key for whichever provider you want
# to use. app.py loads .env automatically via python-dotenv. Never commit
# the real .env file — it's already listed in .gitignore.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Alternative providers (only one is needed):
# OPENAI_API_KEY=sk-your-key-here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# AZURE_OPENAI_API_KEY=your-azure-key-here
